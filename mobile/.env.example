# ==============================================================================
# AxioMedica Mobile (Expo) Environment Configuration (.env)
# In Expo SDK, all client-facing variables MUST start with EXPO_PUBLIC_
# ==============================================================================

# Backend API Base URL
# For Web Browser & iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# For Physical Phone testing via Expo Go (replace with your machine's Wi-Fi IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1

# TTS Service Base URL (OmniVoice audio narration)
EXPO_PUBLIC_TTS_URL=http://localhost:8001

# Mock Data Mode (set to 'true' to run fully offline without backend or database)
EXPO_PUBLIC_USE_MOCK=false
