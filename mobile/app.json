{
  "expo": {
    "name": "RehabStep AI",
    "slug": "rehabstep-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8FAF8F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rehabstep.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "RehabStep AI needs camera access to track joint angles and evaluate rehabilitation exercise form in real time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8FAF8F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.rehabstep.ai",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "RehabStep AI needs camera access to track joint angles and evaluate rehabilitation exercise form in real time."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#6B8F6B"
    }
  }
}
