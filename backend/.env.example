# ==============================================================================
# AxioMedica Backend Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Database ---
# Local host connection (for running uvicorn directly outside Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/axiomedica_db

# Inside Docker compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/axiomedica_db

# PostgreSQL Container Setup (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=axiomedica_db
POSTGRES_PORT=5432

# --- Security & Authentication ---
# Generate a secure 64-char key in production: `openssl rand -hex 32`
JWT_SECRET=insecure_dev_secret_key_change_in_production_12345678
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=30

# --- CORS (Cross-Origin Resource Sharing) ---
# Comma-separated list or JSON array of allowed origins for Expo dev & Web clients
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# --- Application Runtime ---
PROJECT_NAME="AxioMedica Backend API"
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

